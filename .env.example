# Public origin used for same-origin checks and metadata
SITE_URL=https://example.com

# Pooled Neon PostgreSQL connection string (copy it from Neon > Connect)
# On Vercel: required for production CMS, analytics, and admin auth.
# Locally: optional — CMS content saves to data/site.json by default (production is NOT updated).
# Only set CMS_USE_DATABASE=true if you intentionally want local admin to read/write PostgreSQL.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/database?sslmode=require

# Leave unset for normal local editing (data/site.json). Set to "true" only for migration/sync testing.
# CMS_USE_DATABASE=true

# Generate a random value of at least 32 characters (for example: openssl rand -base64 32)
AUTH_SECRET=replace_with_a_long_random_secret

# Persistent upload storage (local fallback when Blob is not configured).
# Defaults to public/uploads when omitted.
UPLOAD_DIR=
UPLOAD_PUBLIC_PATH=/uploads

# Vercel Blob (Storage → amoghaa-blob → .env.local tab).
# This store uses prefix "Blog_", so the store id key is Blog_STORE_ID (not BLOB_STORE_ID).
# Copy both lines from the dashboard, then restart the dev server / redeploy.
Blog_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Optional IANA timezone for analytics "today" cards (default Asia/Kolkata).
# Neon CURRENT_DATE is UTC; without this, early-morning IST visits look like "yesterday".
# ANALYTICS_TIMEZONE=Asia/Kolkata
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Nambiar District 25
MAIL_RECIPIENT=
